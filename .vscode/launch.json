{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Demo: pub/sub heartbeat",
      "type": "debugpy",
      "request": "launch",
      "module": "ros2_robotics_lab.cli",
      "args": ["pubsub", "--rate", "2", "--seconds", "3", "--verbose"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    },
    {
      "name": "Pytest: all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
